{
  "name": "multimodal_robustness_smoke",
  "dataset_name": "refcoco",
  "task_type": "phrase_region_grounding",
  "cache_version": "v0.1",
  "cache_root": "data/multimodal_cache",
  "output_dir": "outputs/multimodal/robustness_smoke",
  "seeds": [401, 402, 403],
  "training_stages": ["T0", "T6"],
  "candidate_names": ["TLEO", "SPO", "LRIO", "CATO"],
  "baseline_names": [
    "text_only",
    "region_only",
    "concat_fusion",
    "cross_attention_transformer",
    "modality_expert_moe",
    "clip_style_region_text_retrieval",
    "cato_only",
    "ovha_no_cato",
    "ovha_no_rceo",
    "ovha_no_evidence_router"
  ],
  "eval_splits": ["val", "test"],
  "eval_episode_count": 128,
  "enforce_same_features_for_baselines": true,
  "fail_on_missing_cache_artifact": true,
  "allow_hidden_losses": false,
  "robustness_corruptions": [
    "missing_text",
    "missing_vision",
    "missing_audio",
    "image_blur",
    "audio_noise",
    "text_token_mask",
    "hard_negative_mismatch"
  ],
  "losses_by_stage": {
    "T0": ["cache_validation"],
    "T6": ["robustness_evaluation_only"]
  },
  "adapter_params_by_candidate": {
    "TLEO": ["lengthscale", "local_temperature", "scale", "bias"],
    "SPO": ["prototype_temperature", "prototype_logits_shift", "scale", "bias"],
    "LRIO": ["rank_logits", "interaction_temperature", "scale", "bias"],
    "CATO": ["alignment_temperature", "transport_scale", "scale", "bias"]
  }
}
