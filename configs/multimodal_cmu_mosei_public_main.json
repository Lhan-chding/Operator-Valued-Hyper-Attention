{
  "name": "multimodal_cmu_mosei_public_main",
  "dataset_name": "cmu_mosei",
  "task_type": "sentiment_emotion",
  "cache_version": "v0.1",
  "cache_root": "data/multimodal_cache",
  "output_dir": "outputs/multimodal/cmu_mosei_main",
  "seeds": [
    301,
    302,
    303,
    304,
    305
  ],
  "main_table_seed_policy": "five_seed_default",
  "training_stages": [
    "T0",
    "T5"
  ],
  "candidate_names": [
    "SPO",
    "LRIO",
    "TANSO"
  ],
  "lrio_pairs": [
    [
      "text",
      "audio"
    ],
    [
      "text",
      "vision"
    ]
  ],
  "use_evidence_router": false,
  "composition_mode": "base_plus_residual",
  "base_candidate": "SPO",
  "residual_candidates": [
    "LRIO",
    "TANSO"
  ],
  "baseline_names": [
    "text_only",
    "audio_only",
    "vision_only",
    "concat_fusion",
    "spo_only",
    "lrio_only",
    "ovha_tanso_only",
    "ovha_no_tanso",
    "ovha_no_lrio",
    "ovha_no_spo",
    "ovha_no_rceo",
    "ovha_with_evidence_router"
  ],
  "eval_splits": [
    "val",
    "test"
  ],
  "eval_episode_count": 4096,
  "enforce_same_features_for_baselines": true,
  "fail_on_missing_cache_artifact": true,
  "allow_hidden_losses": false,
  "losses_by_stage": {
    "T0": [
      "cache_validation"
    ],
    "T5": [
      "task_loss",
      "candidate_individual_loss",
      "spo_prototype_diversity",
      "router_marginal_utility",
      "residual_norm_shrinkage",
      "huber_l1_task_loss",
      "ordinal_acc5_acc7_auxiliary",
      "residual_gate_utility_loss",
      "tanso_source_oracle_gate_loss",
      "val_affine_calibration"
    ]
  },
  "loss_metadata": {
    "candidate_individual_loss": {
      "weight": 0.0,
      "diagnostic_only": true
    },
    "spo_prototype_diversity": {
      "weight": 0.001
    },
    "router_marginal_utility": {
      "weight": 0.01
    },
    "residual_norm_shrinkage": {
      "weight": 0.001
    },
    "task_loss": {
      "weight": 0.2
    },
    "huber_l1_task_loss": {
      "weight": 1.0
    },
    "ordinal_acc5_acc7_auxiliary": {
      "weight": 0.05
    },
    "residual_gate_utility_loss": {
      "weight": 0.01
    },
    "tanso_source_oracle_gate_loss": {
      "weight": 0.01
    },
    "val_affine_calibration": {
      "weight": 0.0,
      "stage": "validation_postfit"
    }
  },
  "adapter_params_by_candidate": {
    "TLEO": [
      "lengthscale",
      "local_temperature",
      "scale",
      "bias"
    ],
    "SPO": [
      "prototype_temperature",
      "prototype_logits_shift",
      "scale",
      "bias"
    ],
    "LRIO": [
      "rank_logits",
      "rank_logits_by_pair",
      "interaction_temperature",
      "interaction_temperature_by_pair",
      "scale",
      "bias"
    ],
    "TANSO": [
      "audio_shift_scale",
      "vision_shift_scale",
      "shift_temperature",
      "audio_lag_logits",
      "vision_lag_logits",
      "lag_width",
      "temporal_temperature",
      "scale",
      "bias"
    ],
    "CATO": [
      "alignment_temperature",
      "transport_scale",
      "scale",
      "bias"
    ]
  }
}
