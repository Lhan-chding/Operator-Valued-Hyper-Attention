{
  "name": "multimodal_cmu_mosei_public_main",
  "dataset_name": "cmu_mosei",
  "task_type": "sentiment_emotion",
  "cache_version": "v0.1",
  "cache_root": "data/multimodal_cache",
  "output_dir": "outputs/multimodal/cmu_mosei_main",
  "seeds": [301, 302, 303, 304, 305],
  "main_table_seed_policy": "five_seed_default",
  "training_stages": ["T0", "T5"],
  "candidate_names": ["TLEO", "SPO", "LRIO", "CATO"],
  "baseline_names": [
    "concat_fusion",
    "tfn_lmf",
    "mult_style_crossmodal_transformer",
    "misa_shared_private",
    "modality_expert_moe",
    "quality_aware_fusion",
    "ovha_no_lrio",
    "ovha_no_spo",
    "ovha_no_rceo",
    "ovha_no_evidence_router"
  ],
  "eval_splits": ["val", "test"],
  "eval_episode_count": 4096,
  "enforce_same_features_for_baselines": true,
  "fail_on_missing_cache_artifact": true,
  "allow_hidden_losses": false,
  "losses_by_stage": {
    "T0": ["cache_validation"],
    "T5": ["task_loss", "candidate_individual_loss"]
  },
  "adapter_params_by_candidate": {
    "TLEO": ["lengthscale", "local_temperature", "scale", "bias"],
    "SPO": ["prototype_temperature", "prototype_logits_shift", "scale", "bias"],
    "LRIO": ["rank_logits", "interaction_temperature", "scale", "bias"],
    "CATO": ["alignment_temperature", "transport_scale", "scale", "bias"]
  }
}
